# Copia questo file in ".env.local" e compila i valori necessari.
# Nessuna di queste variabili è obbligatoria per lo sviluppo locale oggi:
# il sito funziona con i soli file in /content.

# URL pubblico del sito, usato per sitemap, robots.txt e meta tag Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.nettunogold.it

# --- Futuro: integrazione API prenotazioni ---------------------------------
# Quando sarà disponibile il backend prenotazioni, questa variabile conterrà
# l'URL base delle API a cui "lib/data/*.ts" si collegherà (in sostituzione
# della lettura dei file in /content). Vedi il README per i dettagli.
# NEXT_PUBLIC_BOOKING_API_URL=

# Chiave API del backend prenotazioni (server-side, MAI esposta al client).
# BOOKING_API_KEY=

# --- Futuro: analytics rispettoso della privacy -----------------------------
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
